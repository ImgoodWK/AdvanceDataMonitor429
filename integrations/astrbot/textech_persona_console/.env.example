# Copy to .env and replace both required values before docker compose up.
# Generate SESSION_SECRET with at least 24 random characters.
SESSION_SECRET=
# Initial admin password; at least 12 characters. Change it after first login.
CONSOLE_BOOTSTRAP_PASSWORD=
# Optional mirror override; the default works from the current CN server.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
