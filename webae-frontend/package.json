{
  "name": "textech-webae-frontend",
  "version": "3.0.0-rc.3",
  "private": true,
  "type": "module",
  "description": "TeXTech WebAE Console - React + Ant Design frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-webae.mjs",
    "build:no-typecheck": "node scripts/build-webae.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('../.workspace/webae-build',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/leaflet": "1.9.22",
    "@types/supercluster": "^7.1.3",
    "antd": "^6.5.3",
    "cytoscape": "^3.34.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "fflate": "^0.8.2",
    "gridstack": "^13.0.2",
    "leaflet": "1.9.4",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "5.0.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
