{
  "name": "textech-webae-frontend",
  "version": "3.0.0-rc.3",
  "private": true,
  "type": "module",
  "description": "TeXTech WebAE Console - React + Ant Design frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-webae.mjs",
    "build:no-typecheck": "node scripts/build-webae.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('../.workspace/webae-build',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@types/leaflet": "1.9.14",
    "@types/supercluster": "^7.1.3",
    "antd": "^5.22.2",
    "cytoscape": "^3.34.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "fflate": "^0.8.2",
    "gridstack": "^11.1.0",
    "leaflet": "1.9.4",
    "modern-screenshot": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "4.2.1",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
