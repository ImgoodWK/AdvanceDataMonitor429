{
  "name": "textech-cardbattle-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TeXTech Card Battle authoritative server (standalone from WebAE / GTNH tick)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "art:requirements": "node scripts/card-art-requirements.mjs",
    "art:index-refs": "node scripts/index-mod-textures.mjs",
    "art:generate": "node scripts/generate-card-art.mjs",
    "art:ab": "node scripts/ab-card-art.mjs",
    "art:recover": "python scripts/recover-card-art.py",
    "catalog:export": "tsx scripts/export-catalog.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
