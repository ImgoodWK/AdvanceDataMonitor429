# Copy to .env for local override (optional). Prefer user env for secrets.
CARDBATTLE_PORT=8787
CARDBATTLE_HOST=127.0.0.1
CARDBATTLE_DEV_TOKEN=dev
CARDBATTLE_DEV_OWNER_NAME=DevPlayer
# Standalone persistent ledger/session directory.
CARDBATTLE_DATA_DIR=./data/runtime
# Optional comma-separated browser origins. Empty accepts the requesting origin.
CARDBATTLE_CORS_ORIGINS=
# Set only for a trusted MC delivery bridge. Never expose this to the browser.
CARDBATTLE_BRIDGE_TOKEN=
# Optional prebuilt SPA directory. Docker sets this automatically.
CARDBATTLE_FRONTEND_DIR=
